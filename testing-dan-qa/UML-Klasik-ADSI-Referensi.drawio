<mxCell id="c208" value="Arah pesan / stimulus" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="2970" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c209" value="Panah kecil di dekat link, label &#x27;n: nama_pesan(parameter)&#x27;. Arah panah menunjukkan objek PENERIMA pesan. Jika 2 arah pesan berbeda, gambar 2 panah di 2 sisi link." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="2970" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c210" value="" style="points;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="3010" width="1" height="1" as="geometry"/></mxCell>
<mxCell id="c211" value="" style="points;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="260" y="3010" width="1" height="1" as="geometry"/></mxCell>
