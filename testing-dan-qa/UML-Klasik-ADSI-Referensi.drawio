<mxCell id="c213" value="5. STATECHART DIAGRAM (Diagram Status) — Bab 8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3090" width="960" height="44" as="geometry"/></mxCell>
<mxCell id="c214" value="Status awal / Kondisi awal" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="3144" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c215" value="Lingkaran hitam PENUH (solid). Satu diagram status hanya punya SATU status awal." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3144" width="480" height="90" as="geometry"/></mxCell>
