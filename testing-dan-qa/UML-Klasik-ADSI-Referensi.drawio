<mxCell id="c218" value="Kotak dengan sudut membulat (rounded rectangle). Kondisi yang dialami objek selama hidupnya." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3250" width="480" height="90" as="geometry"/></mxCell>
