<mxCell id="c220" value="Status akhir / Kondisi akhir" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="3356" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c221" value="Lingkaran dengan cincin luar + titik hitam penuh di tengah (bullseye). Satu diagram status hanya punya SATU status akhir." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3356" width="480" height="90" as="geometry"/></mxCell>
