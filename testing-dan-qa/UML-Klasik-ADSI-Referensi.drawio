<mxCell id="c204" value="Garis lurus TANPA panah menghubungkan 2 objek (relasi statik). Pesan digambar terpisah di dekat link ini." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="2864" width="480" height="90" as="geometry"/></mxCell>
