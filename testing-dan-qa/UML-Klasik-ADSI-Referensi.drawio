<mxCell id="c199" value="4. COLLABORATION DIAGRAM (Diagram Kolaborasi) — Bab 7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2704" width="960" height="44" as="geometry"/></mxCell>
