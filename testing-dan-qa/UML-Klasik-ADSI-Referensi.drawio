<mxCell id="c115" value="Garis putus-putus + panah terbuka, label &lt;&lt;extend&gt;&gt;. Use case tambahan berdiri sendiri (opsional), mirip inheritance. Panah menuju use case yang ditambahkan." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="506" width="480" height="90" as="geometry"/></mxCell>
