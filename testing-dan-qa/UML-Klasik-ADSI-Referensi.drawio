<mxCell id="c101" value="REFERENSI SIMBOL UML KLASIK — Modul ADSI (Analisis dan Desain Sistem Informasi)
Dipakai sebagai acuan AI agent saat diminta membuat diagram UML secara cepat, sesuai notasi yang dipakai dosen (bukan UML 2.x / gaya tool lain)." style="rounded=0;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="960" height="70" as="geometry"/></mxCell>
<mxCell id="c102" value="1. USE CASE DIAGRAM — Bab 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="960" height="44" as="geometry"/></mxCell>
<mxCell id="c103" value="Use Case" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="188" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c104" value="Fungsionalitas yang disediakan sistem, unit yang bertukar pesan dengan aktor. Nama pakai kata kerja." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="188" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c105" value="nama use case" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="203" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="c106" value="Aktor / Actor" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="294" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c107" value="Orang, proses, atau sistem lain di luar sistem yang berinteraksi dengannya. Belum tentu manusia. Nama pakai kata benda." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="294" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c108" value="nama aktor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#1F4E79;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="294" width="60" height="80" as="geometry"/></mxCell>
<mxCell id="c109" value="Asosiasi / Association" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c110" value="Garis lurus tanpa panah: komunikasi antara aktor dan use case yang berinteraksi dengannya." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="480" height="90" as="geometry"/></mxCell>
