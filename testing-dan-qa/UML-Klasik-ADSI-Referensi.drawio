<mxCell id="c189" value="Panah PUTUS-PUTUS, label &#x27;n: keluaran&#x27;. Objek yang selesai menjalankan operasi mengembalikan nilai. Panah mengarah ke objek penerima kembalian." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="2478" width="480" height="90" as="geometry"/></mxCell>
