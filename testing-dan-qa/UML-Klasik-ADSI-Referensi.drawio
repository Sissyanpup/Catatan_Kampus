<mxCell id="c120" value="Garis solid + panah segitiga kosong (hollow triangle). Hubungan umum-khusus antar 2 use case; panah menuju use case yang lebih umum." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="612" width="480" height="90" as="geometry"/></mxCell>
