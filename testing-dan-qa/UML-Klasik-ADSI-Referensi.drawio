<mxCell id="c229" value="6. ACTIVITY DIAGRAM (Diagram Aktivitas) — Bab 9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3582" width="960" height="44" as="geometry"/></mxCell>
<mxCell id="c230" value="Status awal" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="3636" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c231" value="Lingkaran hitam PENUH. Satu diagram aktivitas hanya punya SATU status awal. Langkah 1 dalam menggambar." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3636" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c232" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="110" y="3661" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="c233" value="Aktivitas" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="3742" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c234" value="Bentuk STADIUM/pil (rounded penuh di kedua ujung), bukan kotak biasa. Aktivitas yang dilakukan SISTEM (bukan aktor), nama diawali kata kerja." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3742" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c235" value="aktivitas" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="3762" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="c236" value="Percabangan / Decision" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="3848" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c237" value="Belah ketupat (diamond). Dipakai saat ada pilihan aktivitas lebih dari satu (kondisi/keputusan). Setiap percabangan harus diakhiri simbol penggabungan." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3848" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c238" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="3863" width="100" height="60" as="geometry"/></mxCell>
<mxCell id="c239" value="Fork" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="3954" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c240" value="Bar hitam tebal horizontal. Memecah SATU aktivitas jadi BEBERAPA aktivitas yang berjalan paralel/bersamaan." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3954" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c241" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="3994" width="140" height="8" as="geometry"/></mxCell>
<mxCell id="c242" value="Join" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="4060" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c243" value="Bar hitam tebal horizontal (bentuk sama seperti fork). Menggabungkan BEBERAPA aktivitas paralel jadi SATU kembali sebelum lanjut." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="4060" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c244" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="4100" width="140" height="8" as="geometry"/></mxCell>
<mxCell id="c245" value="Status akhir" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="4166" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c246" value="Lingkaran dengan cincin luar + titik hitam penuh di tengah (bullseye) — sama seperti status akhir di Statechart. Satu diagram hanya punya SATU status akhir. Langkah terakhir menggambar." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="4166" width="480" height="90" as="geometry"/></mxCell>
<mxCell id="c247" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="105" y="4181" width="40" height="40" as="geometry"/></mxCell>
<mxCell id="c248" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="115" y="4191" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c249" value="Swimlane" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="4272" width="200" height="160" as="geometry"/></mxCell>
<mxCell id="c250" value="Kotak vertikal/horizontal berlabel nama organisasi/objek. Memisahkan siapa/apa yang bertanggung jawab atas aktivitas tertentu dalam diagram yang sama." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="4272" width="480" height="160" as="geometry"/></mxCell>
<mxCell id="c251" value="nama swimlane" style="swimlane;horizontal=1;startSize=24;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="4282" width="180" height="130" as="geometry"/></mxCell>
<mxCell id="c252" value="7. COMPONENT DIAGRAM (Diagram Komponen) — Bab 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="4462" width="960" height="44" as="geometry"/></mxCell>
<mxCell id="c253" value="Komponen" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="4516" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="c254" value="Kotak dengan ikon 2 kotak kecil (&#x27;colokan&#x27;) menempel di sisi kiri. Aspek FISIK sistem: modul berisi code (library/executable), file, atau dokumen. Umumnya terbentuk dari beberapa class/package." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="4516" width="480" height="100" as="geometry"/></mxCell>
<mxCell id="c255" value="nama_komponen.exe" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="4536" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="c256" value="8. DEPLOYMENT DIAGRAM (Diagram Deployment) — Bab 11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="4646" width="960" height="44" as="geometry"/></mxCell>
<mxCell id="c257" value="Node" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="4700" width="200" height="110" as="geometry"/></mxCell>
<mxCell id="c258" value="Kubus/balok 3D. Merepresentasikan perangkat keras fisik (server, client, printer, dll) tempat komponen di-deploy dan dijalankan. Komponen (dari diagram komponen) bisa diletakkan di dalam node." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="4700" width="480" height="110" as="geometry"/></mxCell>
<mxCell id="c259" value="nama_node" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="4715" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="c260" value="9. CATATAN — Kohesi &amp; Kopling (Bab 12, bukan simbol diagram)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="4840" width="960" height="44" as="geometry"/></mxCell>
<mxCell id="c261" value="Bukan simbol gambar, tapi prinsip kualitas desain yang harus dijaga saat membuat Class Diagram / Component Diagram:
- Kohesi TINGGI = baik (Functional cohesion = terbaik)
- Kopling RENDAH = baik (Data coupling = terbaik, Content coupling = terburuk)" style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="4894" width="900" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>