<mxCell id="c129" value="2. CLASS DIAGRAM &amp; OBJECT DIAGRAM — Bab 6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="960" height="44" as="geometry"/></mxCell>
