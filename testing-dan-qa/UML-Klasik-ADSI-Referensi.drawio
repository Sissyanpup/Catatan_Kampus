<mxCell id="c131" value="Kotak 3 bagian: Nama Kelas / Atribut / Operasi. Atribut = variabel kelas, Operasi = fungsi/metode kelas." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="892" width="480" height="110" as="geometry"/></mxCell>
