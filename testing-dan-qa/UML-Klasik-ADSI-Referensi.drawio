<mxCell id="c224" value="Transisi" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="3462" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c225" value="Garis panah antar status. Biasanya diberi nama pesan/event pemicu (event yang menyebabkan objek pindah status). Bisa juga memutar ke status sendiri (internal transition)." style="text;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="3462" width="480" height="90" as="geometry"/></mxCell>
